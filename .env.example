APP_NAME=Mieszkania
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Bez domeny zostaw ":80" i porty na 127.0.0.1 (dostęp przez tunel SSH).
# Z domeną: CADDY_DOMAIN=twoja-domena.pl, CADDY_HTTP_BIND=80, CADDY_HTTPS_BIND=443
CADDY_DOMAIN=:80
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_HTTPS_BIND=127.0.0.1:8443

# 1 = obraz z paczkami dev (testy w kontenerze), 0 = produkcja
INSTALL_DEV=0

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mieszkania
DB_USERNAME=mieszkania
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Scraping
SCRAPE_INTERVAL_MINUTES=20
SCRAPER_DELAY_MS=4000
SCRAPER_MAX_PAGES=3
SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36"

# AI (SPRAWDŹ wartości w dokumentacji OpenCode Go)
OPENCODE_GO_BASE_URL=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=
AI_MAX_PER_MINUTE=20

# Powiadomienia
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_RENT=
DISCORD_WEBHOOK_URL_SALE=
NOTIFY_DIGEST_THRESHOLD=5
NOTIFY_PRICE_DROPS=true
