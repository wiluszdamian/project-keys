APP_NAME=Mieszkania
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Bez domeny zostaw puste i porty na 127.0.0.1 (dostęp przez tunel SSH).
# Z domeną: CADDY_DOMAIN=twoja-domena.pl, CADDY_HTTP_BIND=0.0.0.0:80, CADDY_HTTPS_BIND=0.0.0.0:443.
# Za proxy Cloudflare (tryb SSL Full) Caddy sam pobierze certyfikat, a adres klienta bierze z CF-Connecting-IP.
CADDY_DOMAIN=
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_HTTPS_BIND=127.0.0.1:8443
# Wejście po IP serwera (blok :80) tylko z tych adresów (spacja między adresami). Domena ma hasło niżej.
# Żeby otworzyć panel po IP serwera: CADDY_HTTP_BIND=0.0.0.0:80 i tu swój adres.
PANEL_ALLOWED_IPS=127.0.0.1
# Hasło przeglądarki (basic auth) na domenie. Hash: docker compose exec caddy caddy hash-password
# Hash w pojedynczych cudzysłowach, bo zawiera znaki $.
PANEL_BASIC_AUTH_USER=panel
PANEL_BASIC_AUTH_HASH=

# 1 = obraz z paczkami dev (testy w kontenerze), 0 = produkcja
INSTALL_DEV=0

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mieszkania
DB_USERNAME=mieszkania
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Scraping
SCRAPE_INTERVAL_MINUTES=20
SCRAPER_DELAY_MS=4000
SCRAPER_MAX_PAGES=3
SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36"

# AI: OpenCode Go (https://opencode.ai/docs/go/), API zgodne z OpenAI.
# Pay-as-you-go zamiast subskrypcji Go: https://opencode.ai/inference/openai/v1
AI_PROVIDER=opencode
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
AI_MAX_PER_MINUTE=20
# false = oferty idą bez oceny AI
AI_ENABLED=true

# Powiadomienia
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_RENT=
DISCORD_WEBHOOK_URL_SALE=
NOTIFY_DIGEST_THRESHOLD=5
NOTIFY_PRICE_DROPS=true
# Alerty systemowe zawsze w panelu, na Discorda tylko po włączeniu
NOTIFY_ALERTS_DISCORD=false
# Raport rynku w soboty o 20:00 (Discord i panel)
NOTIFY_WEEKLY_REPORT=true

# Ceny transakcyjne z Rejestru Cen Nieruchomości (GUGiK). Powiaty TERYT po przecinku: 1863 Rzeszów, 1816 powiat rzeszowski
RCN_ENABLED=true
RCN_COUNTIES=1863,1816

# Stawki do symulacji kredytu (RKM). Domyślne z 2026-11-20, zwykle zmieniasz je w panelu (Ustawienia, Kredyt)
# MORTGAGE_RATES_DATE=2026-11-20
# MORTGAGE_INDEX_NAME="POLSTR 1M"
# MORTGAGE_INDEX_RATE=3.49
# MORTGAGE_NBP_RATE_AT_DATE=3.75
# MORTGAGE_MARGIN=2.3
# MORTGAGE_FIXED_RATE=6.2
