{
	servers {
		# Ruch przez proxy Cloudflare: prawdziwy adres klienta jest w CF-Connecting-IP.
		# Ufamy mu tylko, gdy połączenie przychodzi z adresów Cloudflare (lista z cloudflare.com/ips, 2026-11-18).
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(site) {
	root * /var/www/html/public
	encode zstd gzip
	php_fastcgi app:9000
	file_server
}

# Domena (np. przez proxy Cloudflare): HTTPS z certyfikatem Let's Encrypt, dostęp z każdego adresu.
# Panel chroni logowanie (login + passkey), API tokeny Sanctum. Wyszukiwarki nie indeksują strony.
{$CADDY_DOMAIN:http://localhost} {
	header X-Robots-Tag "noindex, nofollow"
	import site
}

# Adres IP serwera i tunel SSH, zwykły HTTP. Tylko z PANEL_ALLOWED_IPS i sieci prywatnych.
# client_ip to adres klienta: przez Cloudflare z nagłówka, bez Cloudflare adres połączenia.
:80 {
	@denied not client_ip {$PANEL_ALLOWED_IPS:127.0.0.1} private_ranges
	respond @denied "Brak dostępu" 403
	import site
}
