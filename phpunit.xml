<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env force="true" name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env force="true" name="CACHE_STORE" value="array"/>
        <!-- Osobna baza testowa w Postgresie (scripts/test.sh). Nigdy główna baza. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="mieszkania_test" force="true"/>
        <env name="DB_USERNAME" value="test" force="true"/>
        <env name="DB_PASSWORD" value="test" force="true"/>
        <env name="DB_URL" value=""/>
        <env force="true" name="MAIL_MAILER" value="array"/>
        <!-- Testy nigdy nie wysyłają na prawdziwy webhook z .env. -->
        <env force="true" name="DISCORD_WEBHOOK_URL" value=""/>
        <env force="true" name="DISCORD_WEBHOOK_URL_RENT" value=""/>
        <env force="true" name="DISCORD_WEBHOOK_URL_SALE" value=""/>
        <env force="true" name="TELEGRAM_BOT_TOKEN" value=""/>
        <!-- Testy nigdy nie wołają prawdziwego modelu AI. -->
        <env force="true" name="OPENCODE_GO_API_KEY" value=""/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <!-- Testy nie czytają stanu kopii z serwera. -->
        <env force="true" name="BACKUP_EXPECTED" value="false"/>
        <env force="true" name="BACKUP_STATUS_PATH" value=""/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
